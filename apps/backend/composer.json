{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "Dompet Kita - Sweet Financial Advisor (CACHE_BUST_2026_03_21_09_52)",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "akaunting/laravel-firewall": "^1.3",
        "google-gemini-php/client": "^2.7",
        "google/apiclient": "^2.19",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.25",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mpdf/mpdf": "^8.3",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-redis": "*",
        "ext-bcmath": "*",
        "sabberworm/php-css-parser": "^9.3",
        "sentry/sentry-laravel": "^4.22",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-honeypot": "^4.7",
        "symfony/google-mailer": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "nunomaduro/phpinsights": "^2.14",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "files": [
            "bootstrap/firewall_autoload_patch.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test-parallel": [
            "vendor/bin/pest --parallel"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "scan:snyk": [
            "../../bin/snyk.exe test --all-projects --severity-threshold=high 2>&1 > ../../reports/backend-snyk.txt || exit 0"
        ],
        "scan": [
            "@scan:snyk",
            "php artisan insights --no-interaction --min-quality=90 --min-complexity=90 > ../../reports/backend-insights.txt || exit 0",
            "vendor/bin/phpstan analyse --memory-limit=2G --no-progress > ../../reports/backend-phpstan.txt || exit 0",
            "vendor/bin/rector process --dry-run > ../../reports/backend-rector.txt || exit 0"
        ],
        "scan:fix": [
            "php artisan insights --no-interaction --fix > ../../reports/backend-insights-fix.txt || exit 0",
            "vendor/bin/pint > ../../reports/backend-pint.txt || exit 0",
            "vendor/bin/rector process > ../../reports/backend-rector-fix.txt || exit 0"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "discovery": {
            "psr/http-client-implementation": "Symfony\\Component\\HttpClient\\Psr18Client",
            "psr/http-factory-implementation": "Nyholm\\Psr7\\Factory\\Psr17Factory"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 2000,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
