includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - database/
        - tests/

    # scanFiles:
    #     - _ide_helper.php
    #     - _ide_helper_models.php

    # Level 9 - Zero-Tolerance Mode (Expert Absolute Standard)
    level: 9

    ignoreErrors:
        # Resolving legacy ignore rules
        # - '#PHPDoc tag @var#'

    excludePaths:
        - ./*/*/FileToBeExcluded.php

    # checkMissingIterableValueType: false
