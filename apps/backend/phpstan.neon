includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./vendor/pestphp/pest/extension.neon

parameters:

    paths:
        - app/
        - database/
        - tests/

    # scanFiles:
    #     - _ide_helper.php
    #     - _ide_helper_models.php

    # Level 9 - Zero-Tolerance Mode (Expert Absolute Standard)
    level: 9
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        - '#Cannot access offset .* on mixed#'
        - '#Cannot cast mixed to (int|string|float|bool)#'
        # Pest test closures use $this binding at runtime; PHPStan cannot see it statically.
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'

    excludePaths:
        - ./*/*/FileToBeExcluded.php

    # checkMissingIterableValueType: false
