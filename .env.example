# 🌍 DOMPET KITA: MASTER ENVIRONMENT CONFIGURATION
# Copy this file to .env and distribute to respective backend/frontend environments

# --- BACKEND (.env) ---
APP_NAME="Dompet Kita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Supabase PostgreSQL / Local)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dompet_kita
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis / Cache Data
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SANCTUM_IDLE_EXPIRATION=30
SANCTUM_ABSOLUTE_EXPIRATION=1440

# Storj Cloud Credentials (S3 Compatible)
AWS_ACCESS_KEY_ID=your_storj_access_key
AWS_SECRET_ACCESS_KEY=your_storj_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dompet-kita-assets
AWS_ENDPOINT=https://gateway.storjshare.io

# External APIs
GEMINI_API_KEY=your_gemini_api_key

# --- FRONTEND (.env) ---
VITE_API_URL=http://localhost:8000/api
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
