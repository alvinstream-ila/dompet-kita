#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "======================================"
echo "🚀 Running Dompet Kita Pre-Push Checks"
echo "======================================"

echo "1/4: Checking Frontend Code Quality (Linting)..."
cd apps/frontend
if ! npm run lint; then
  echo "❌ Frontend Linting Failed! Please fix errors before pushing."
  exit 1
fi

echo "2/4: Checking Frontend Build (TypeScript)..."
if ! npm run build; then
  echo "❌ Frontend Build Failed! Please fix errors before pushing."
  exit 1
fi

echo "3/4: Running Frontend CLI Audit (Design, SEO, Security)..."
if ! npm run ci:frontend-check; then
  echo "❌ Frontend Audit Failed! Please resolve CLI warnings before pushing."
  exit 1
fi
cd ../..

if command -v php >/dev/null 2>&1; then
  echo "4/4: Checking Backend Security Gate (Elite Threshold: 95)..."
  if ! php apps/backend/artisan security:gate --min-score=95; then
    echo "❌ Backend Security Gate Failed! Score below 95. Resolve all high/medium vulnerabilities before pushing."
    exit 1
  fi
else
  echo "⚠️ PHP not found in environment, skipping backend gate checks for this push..."
fi

echo "======================================"
echo "✅ All checks passed! Ready to push."
echo "======================================"
